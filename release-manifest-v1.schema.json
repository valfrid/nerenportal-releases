{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/valfrid/nerenportal-releases/blob/main/release-manifest-v1.schema.json",
  "title": "Family Portal canonical signed release manifest v1",
  "description": "Strict schema of the canonical JSON signed by Ed25519. Trust must be anchored in a public key pinned in the Installer, not obtained from the release itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "channel",
    "version",
    "sourceCommit",
    "publishedAt",
    "minFromVersion",
    "minSchema",
    "targetSchema",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "family-portal"
    },
    "channel": {
      "const": "stable"
    },
    "version": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "minFromVersion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      ]
    },
    "minSchema": {
      "type": "integer",
      "minimum": 0
    },
    "targetSchema": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "bytes"
          ],
          "properties": {
            "name": {
              "const": "portal-worker-package.tar.gz"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "bytes"
          ],
          "properties": {
            "name": {
              "const": "schema-migrations.tar.gz"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        }
      ],
      "items": false
    },
    "notes": {
      "type": "object",
      "required": [
        "sv"
      ],
      "additionalProperties": false,
      "properties": {
        "sv": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
